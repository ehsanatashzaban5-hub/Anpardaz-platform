NODE_ENV=production
PORT=4001
CORS_ORIGIN=https://your-web-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/anpardaz
IDENTITY_SERVICE_URL=https://identity.your-domain.example
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PUBLIC_KEY_B64=BASE64-DER-ED25519-PUBLIC-KEY

# Iran-only banking/service access. Production fails closed when country cannot be verified.
IP_GEOLOCATION_URL_TEMPLATE=https://<trusted-geolocation-provider>/{ip}
IP_GEOLOCATION_TIMEOUT_MS=2500
IP_POLICY_ENFORCE_NON_PRODUCTION=false
IP_POLICY_ALLOW_PRIVATE_NETWORKS=false
# Production app is bound to localhost behind the trusted HTTPS reverse proxy; enable proxy IP extraction.
TRUST_PROXY=true

# WebAuthn device-lock enforcement
WEBAUTHN_RP_NAME=An Pardaz
WEBAUTHN_RP_ID=your-web-domain.example
WEBAUTHN_ORIGIN=https://your-web-domain.example
