NODE_ENV=production
PORT=4001
CORS_ORIGIN=https://your-web-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/anpardaz
IDENTITY_SERVICE_URL=https://identity.your-domain.example
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PUBLIC_KEY_B64=BASE64-DER-ED25519-PUBLIC-KEY
ANPARDAZ_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
ACCOUNTING_SERVICE_URL=https://accounting-api.your-domain.example
ACCOUNTING_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
BANKING_PROVIDER_WORKER_INTERVAL_MS=5000
IP_GEOLOCATION_URL_TEMPLATE=https://<trusted-geolocation-provider>/{ip}
IP_GEOLOCATION_TIMEOUT_MS=2500
IP_POLICY_ENFORCE_NON_PRODUCTION=false
IP_POLICY_ALLOW_PRIVATE_NETWORKS=false
TRUST_PROXY=true

WEBAUTHN_RP_NAME=An Pardaz
WEBAUTHN_RP_ID=your-web-domain.example
WEBAUTHN_ORIGIN=https://your-web-domain.example

# Card registration adapter. Keep false until the real Shaparak/PSP contract is configured.
SHAPARAK_CARD_REGISTRATION_ENABLED=false
SHAPARAK_CARD_REGISTRATION_URL=
SHAPARAK_CARD_REGISTRATION_REDIRECT_URI=
SHAPARAK_CARD_REGISTRATION_RETURN_URL=
SHAPARAK_CARD_FINGERPRINT_SECRET=
SHAPARAK_CALLBACK_HMAC_SECRET=

# Banking provider
FINNOTECH_ENABLED=false
FINNOTECH_CLIENT_ID=
FINNOTECH_CLIENT_SECRET=
FINNOTECH_AUTHORIZE_URL=
FINNOTECH_TOKEN_URL=
FINNOTECH_REDIRECT_URI=
FINNOTECH_TOKEN_ENCRYPTION_KEY_B64=
FINNOTECH_BALANCE_PATH=
FINNOTECH_STATEMENT_PATH=
FINNOTECH_TRANSFER_PATH=
FINNOTECH_SAYAD_INQUIRY_PATH=
FINNOTECH_SAYAD_REGISTER_PATH=
FINNOTECH_SAYAD_ACCEPT_PATH=
FINNOTECH_SAYAD_REJECT_PATH=
FINNOTECH_SAYAD_TRANSFER_PATH=
FINNOTECH_SAYAD_CANCEL_PATH=
