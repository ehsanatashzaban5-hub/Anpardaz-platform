NODE_ENV=production
PORT=4008
CORS_ORIGIN=https://your-web-domain.example
DATABASE_URL=postgresql://HOOSH_DB_USER:HOOSH_DB_PASSWORD@hoosh-db:5432/hoosh
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PUBLIC_KEY_B64=BASE64-DER-ED25519-PUBLIC-KEY
TRUST_PROXY=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_COMPAT_API_KEY=
AI_COMPAT_BASE_URL=
AI_COMPAT_MODEL=
HOOSH_WORKER_ENABLED=false
HOOSH_WORKER_INTERVAL_MS=1000
HOOSH_WORKER_LEASE_SECONDS=120
HOOSH_WORKER_MAX_ATTEMPTS=5

HOOSH_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
