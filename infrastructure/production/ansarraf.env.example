NODE_ENV=production
PORT=4002
CORS_ORIGIN=https://your-web-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/ansarraf
IDENTITY_SERVICE_URL=https://identity.your-domain.example
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PUBLIC_KEY_B64=BASE64-DER-ED25519-PUBLIC-KEY
ANSARRAF_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
ACCOUNTING_SERVICE_URL=https://accounting-api.your-domain.example
ACCOUNTING_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
ANPARDAZ_SERVICE_URL=https://anpardaz-api.your-domain.example
ANPARDAZ_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
TRUST_PROXY=true
IP_GEOLOCATION_URL_TEMPLATE=https://<trusted-geolocation-provider>/{ip}
IP_GEOLOCATION_TIMEOUT_MS=2500
IP_POLICY_ENFORCE_NON_PRODUCTION=false
IP_POLICY_ALLOW_PRIVATE_NETWORKS=false

LIQUIDITY_PROVIDER_CODE=WALLEX
LIQUIDITY_PROVIDER_EXECUTION_ENABLED=false
WALLEX_API_BASE_URL=https://api.wallex.ir
WALLEX_API_KEY=CHANGE_ME_USE_RUNTIME_SECRET_STORE
PROVIDER_HTTP_TIMEOUT_MS=10000
PROVIDER_MAX_SLIPPAGE_BPS=100
PROVIDER_RECONCILIATION_INTERVAL_MS=60000
PROVIDER_RECONCILIATION_TOLERANCE=0.00000001
WITHDRAWAL_DUAL_APPROVAL_THRESHOLD=0

KYC_MANUAL_REVIEW_ENABLED=true
KYC_PROVIDER_URL=
KYC_PROVIDER_CODE=
KYC_PROVIDER_API_KEY=
KYC_ENCRYPTION_KEY_B64=BASE64-32-BYTE-KEY
KYC_PROVIDER_TIMEOUT_MS=10000
