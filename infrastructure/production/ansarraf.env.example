NODE_ENV=production
PORT=4002
CORS_ORIGIN=https://your-web-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/ansarraf
IDENTITY_SERVICE_URL=https://identity.your-domain.example
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PUBLIC_KEY_B64=BASE64-DER-ED25519-PUBLIC-KEY

LIQUIDITY_PROVIDER_CODE=WALLEX
LIQUIDITY_PROVIDER_EXECUTION_ENABLED=false
WALLEX_API_BASE_URL=https://api.wallex.ir
WALLEX_API_KEY=CHANGE_ME_USE_RUNTIME_SECRET_STORE
PROVIDER_HTTP_TIMEOUT_MS=10000
PROVIDER_MAX_SLIPPAGE_BPS=100
