NODE_ENV=production
PORT=4003
CORS_ORIGIN=https://your-web-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/platform
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PRIVATE_KEY_B64=BASE64-DER-ED25519-PRIVATE-KEY
GUEST_INTERACTION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
TRUST_PROXY=true
IP_GEOLOCATION_URL_TEMPLATE=https://<trusted-geolocation-provider>/{ip}
IP_POLICY_ALLOW_PRIVATE_NETWORKS=false

# Service-to-service URLs and credentials
ANSARRAF_SERVICE_URL=https://ansarraf-api.your-domain.example
ANPARDAZ_SERVICE_URL=https://anpardaz-api.your-domain.example
ACCOUNTING_SERVICE_URL=https://accounting-api.your-domain.example
ANSARRAF_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
ANPARDAZ_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
ACCOUNTING_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
BANNER_SERVICE_URL=http://banner:4005
BANNER_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE

# Phone OTP
PHONE_OTP_ENABLED=true
OTP_HASH_SECRET=GENERATE_A_LONG_RANDOM_SECRET
KAVENEGAR_API_KEY=CHANGE_ME_USE_RUNTIME_SECRET_STORE
KAVENEGAR_SENDER=CHANGE_ME

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_COMPAT_API_KEY=
AI_COMPAT_BASE_URL=
AI_COMPAT_MODEL=
MARKET_DATA_INTERVAL_MS=30000
MARKET_DATA_SYMBOLS=BTC-USDT,ETH-USDT,BTC-IRT,ETH-IRT
HOOSH_WORKER_ENABLED=false
HOOSH_WORKER_INTERVAL_MS=1000
MARKET_DISCOVERY_INTERVAL_MINUTES=120
MARKET_DISCOVERY_BATCH=25
MARKET_DISCOVERY_TIMEOUT_MS=12000
MARKET_SYNC_INTERVAL_MINUTES=30
MARKET_SYNC_MAX_STORES=50
MARKET_SYNC_TIMEOUT_MS=15000
