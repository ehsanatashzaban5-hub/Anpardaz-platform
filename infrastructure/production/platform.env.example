NODE_ENV=production
PORT=4003
CORS_ORIGIN=https://your-web-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/platform
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PRIVATE_KEY_B64=BASE64-DER-ED25519-PRIVATE-KEY
GUEST_INTERACTION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# Set true only when the service is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional OpenAI-compatible provider (self-hosted/local or any compatible gateway)
AI_COMPAT_API_KEY=
AI_COMPAT_BASE_URL=
AI_COMPAT_MODEL=
MARKET_DATA_INTERVAL_MS=30000
MARKET_DATA_SYMBOLS=BTC-USDT,ETH-USDT,BTC-IRT,ETH-IRT
HOOSH_WORKER_ENABLED=false
HOOSH_WORKER_INTERVAL_MS=1000

# An Market public store discovery / ingestion
MARKET_DISCOVERY_INTERVAL_MINUTES=120
MARKET_DISCOVERY_BATCH=25
MARKET_DISCOVERY_TIMEOUT_MS=12000
MARKET_SYNC_INTERVAL_MINUTES=30
MARKET_SYNC_MAX_STORES=50
MARKET_SYNC_TIMEOUT_MS=15000
