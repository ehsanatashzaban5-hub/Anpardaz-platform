NODE_ENV=production
PORT=4009
CORS_ORIGIN=https://your-web-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/financial
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PUBLIC_KEY_B64=BASE64-DER-ED25519-PUBLIC-KEY
TRUST_PROXY=true
ANPARDAZ_SERVICE_URL=http://anpardaz:4001
ANPARDAZ_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
ANPARDAZ_HTTP_TIMEOUT_MS=5000
ACCOUNTING_SERVICE_URL=http://accounting:4004
ACCOUNTING_INTERNAL_TOKEN=CHANGE_ME_USE_RUNTIME_SECRET_STORE
FINNOTECH_API_BASE_URL=https://api.finnotech.ir
FINNOTECH_CLIENT_ID=CHANGE_ME
FINNOTECH_CLIENT_SECRET=CHANGE_ME
FINNOTECH_AUTHORIZE_URL=CHANGE_ME
FINNOTECH_TOKEN_URL=CHANGE_ME
FINNOTECH_TOKEN_ENCRYPTION_KEY_B64=BASE64-32-BYTE-KEY
FINNOTECH_STATEMENT_PATH=CHANGE_ME
FINNOTECH_REQUEST_TIMEOUT_MS=15000
