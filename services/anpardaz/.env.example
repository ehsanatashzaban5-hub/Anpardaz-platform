# Local/deploy template only. Never commit real credentials.
PORT=4001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://anpardaz:local-anpardaz-password@localhost:5433/anpardaz
IDENTITY_SERVICE_URL=http://localhost:4003
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PUBLIC_KEY_B64=generated-by-bootstrap-local
ANPARDAZ_INTERNAL_TOKEN=generate-a-long-random-secret

# Finotech / banking provider. Keep credentials out of git.
FINTECH_API_BASE_URL=https://api.finnotech.ir
FINTECH_API_KEY=configure-at-deploy-time
FINTECH_API_KEY_HEADER=x-api-key
FINTECH_AUTH_SCHEME=
FINTECH_CLIENT_ID=
FINTECH_NATIONAL_ID=
FINTECH_ENDPOINTS_JSON={"card_balance":"/oak/v1/clients/{clientId}/card/balance?trackId={trackId}","transfer":"/oak/v1/{nid}/clients/{clientId}/transferTo?trackId={trackId}"}
FINTECH_REQUEST_TIMEOUT_MS=15000
