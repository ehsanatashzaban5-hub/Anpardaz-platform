# Local/deploy template only. Never commit real credentials.
PORT=4001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://anpardaz:local-anpardaz-password@localhost:5433/anpardaz
IDENTITY_SERVICE_URL=http://localhost:4003
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PUBLIC_KEY_B64=generated-by-bootstrap-local
ANPARDAZ_INTERNAL_TOKEN=generate-a-long-random-secret

# Finotech / banking provider. Keep credentials out of git.
FINTECH_API_BASE_URL=https://api.finnotech.ir
FINTECH_API_KEY=configure-at-deploy-time
FINTECH_API_KEY_HEADER=x-api-key
FINTECH_AUTH_SCHEME=
FINTECH_CLIENT_ID=
FINTECH_NATIONAL_ID=
FINTECH_ENDPOINTS_JSON={"card_balance":"/oak/v1/clients/{clientId}/card/balance?trackId={trackId}","transfer":"/oak/v1/{nid}/clients/{clientId}/transferTo?trackId={trackId}"}
FINTECH_REQUEST_TIMEOUT_MS=15000

# Finnotech banking integration. Configure real production values at deploy time.
FINNOTECH_ENABLED=false
FINNOTECH_API_BASE_URL=https://api.finnotech.ir
FINNOTECH_CLIENT_ID=configure-at-deploy-time
FINNOTECH_CLIENT_SECRET=configure-at-deploy-time
FINNOTECH_AUTHORIZE_URL=configure-at-deploy-time
FINNOTECH_TOKEN_URL=configure-at-deploy-time
FINNOTECH_REDIRECT_URI=https://your-domain.example/api/v1/banking/finnotech/callback
FINNOTECH_POST_AUTH_REDIRECT=https://your-domain.example/
FINNOTECH_SCOPE=configure-at-deploy-time
FINNOTECH_TOKEN_ENCRYPTION_KEY_B64=generate-a-32-byte-base64-key
FINNOTECH_REQUEST_TIMEOUT_MS=15000
# Exact endpoint paths must be taken from the active Finnotech product contract/docs; no guessed endpoint is used.
FINNOTECH_BALANCE_PATH=
FINNOTECH_STATEMENT_PATH=
FINNOTECH_TRANSFER_PATH=

# An Pardaz — Sayad cheque API paths (exact paths supplied by the Finnotech production contract)
FINNOTECH_SAYAD_INQUIRY_PATH=
FINNOTECH_SAYAD_REGISTER_PATH=
FINNOTECH_SAYAD_ACCEPT_PATH=
FINNOTECH_SAYAD_REJECT_PATH=
FINNOTECH_SAYAD_TRANSFER_PATH=
FINNOTECH_SAYAD_CANCEL_PATH=


# Shaparak card ownership/registration. Keep all secrets out of git.
SHAPARAK_CARD_REGISTRATION_ENABLED=false
SHAPARAK_CARD_REGISTRATION_URL=configure-at-deploy-time
SHAPARAK_CARD_REGISTRATION_REDIRECT_URI=https://your-domain.example/api/v1/cards/registration/callback
SHAPARAK_CARD_REGISTRATION_RETURN_URL=https://your-domain.example/
SHAPARAK_CARD_FINGERPRINT_SECRET=generate-a-long-random-secret
# Required when Shaparak card registration is enabled. The exact signature scheme must come from the contracted provider; never accept unsigned callbacks in production.
SHAPARAK_CALLBACK_HMAC_SECRET=configure-at-deploy-time
# The provider contract must also define what approved callback fields carry the provider card token/reference,
# last4 and ownership result. Do not enable production until those exact fields and signature rules are confirmed.
# The return URL may be an HTTPS web route or an approved An Pardaz app deep-link registered for the mobile app.

# Iran-only banking/service access. Production fails closed when country cannot be verified.
IP_GEOLOCATION_URL_TEMPLATE=https://<trusted-geolocation-provider>/{ip}
IP_GEOLOCATION_TIMEOUT_MS=2500
IP_POLICY_ENFORCE_NON_PRODUCTION=false
IP_POLICY_ALLOW_PRIVATE_NETWORKS=true
TRUST_PROXY=false

# WebAuthn device-lock enforcement. Production values must match the public mobile/web origin.
WEBAUTHN_RP_NAME=An Pardaz
WEBAUTHN_RP_ID=your-domain.example
WEBAUTHN_ORIGIN=https://your-domain.example
