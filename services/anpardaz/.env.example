# Local/deploy template only. Never commit real credentials.
PORT=4001
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://anpardaz:local-anpardaz-password@localhost:5433/anpardaz
IDENTITY_SERVICE_URL=http://localhost:4003
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PUBLIC_KEY_B64=generated-by-bootstrap-local
ANPARDAZ_INTERNAL_TOKEN=generate-a-long-random-secret

# Finotech / banking provider. Keep credentials out of git.
FINTECH_API_BASE_URL=https://api.finnotech.ir
FINTECH_API_KEY=configure-at-deploy-time
FINTECH_API_KEY_HEADER=x-api-key
FINTECH_AUTH_SCHEME=
FINTECH_CLIENT_ID=
FINTECH_NATIONAL_ID=
FINTECH_ENDPOINTS_JSON={"card_balance":"/oak/v1/clients/{clientId}/card/balance?trackId={trackId}","transfer":"/oak/v1/{nid}/clients/{clientId}/transferTo?trackId={trackId}"}
FINTECH_REQUEST_TIMEOUT_MS=15000

# Finnotech banking integration. Configure real production values at deploy time.
FINNOTECH_ENABLED=false
FINNOTECH_API_BASE_URL=https://api.finnotech.ir
FINNOTECH_CLIENT_ID=configure-at-deploy-time
FINNOTECH_CLIENT_SECRET=configure-at-deploy-time
FINNOTECH_AUTHORIZE_URL=configure-at-deploy-time
FINNOTECH_TOKEN_URL=configure-at-deploy-time
FINNOTECH_REDIRECT_URI=https://your-domain.example/api/v1/banking/finnotech/callback
FINNOTECH_POST_AUTH_REDIRECT=https://your-domain.example/
FINNOTECH_SCOPE=configure-at-deploy-time
FINNOTECH_TOKEN_ENCRYPTION_KEY_B64=generate-a-32-byte-base64-key
FINNOTECH_REQUEST_TIMEOUT_MS=15000
# Exact endpoint paths must be taken from the active Finnotech product contract/docs; no guessed endpoint is used.
FINNOTECH_BALANCE_PATH=
FINNOTECH_STATEMENT_PATH=
FINNOTECH_TRANSFER_PATH=

# Finnotech service endpoint registry. Exact paths/methods must match your current Finnotech contract.
FINNOTECH_SERVICE_ENDPOINTS_JSON={}
