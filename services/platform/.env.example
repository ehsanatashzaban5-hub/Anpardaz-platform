# Local development only. Never commit real secrets.
PORT=4003
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://platform:local-platform-password@localhost:5435/platform
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PRIVATE_KEY_B64=generated-by-bootstrap-local

ANSARRAF_SERVICE_URL=http://localhost:4002
ANPARDAZ_SERVICE_URL=http://localhost:4001
ACCOUNTING_SERVICE_URL=http://localhost:4004
ANSARRAF_INTERNAL_TOKEN=generate-a-long-random-secret
ANPARDAZ_INTERNAL_TOKEN=generate-a-long-random-secret
ACCOUNTING_INTERNAL_TOKEN=generate-a-long-random-secret

# AI providers (server-side only; never expose keys to web/mobile)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Optional OpenAI-compatible provider catalog, JSON array of {id,name,providerId,descFa,capabilities,contextWindow}
AI_COMPAT_API_KEY=
AI_COMPAT_BASE_URL=
AI_COMPAT_MODEL=
AI_COMPAT_MODELS_JSON=
