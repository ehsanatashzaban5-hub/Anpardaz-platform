# Local development only. Never commit real secrets.
PORT=4002
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://ansarraf:local-ansarraf-password@localhost:5434/ansarraf
IDENTITY_SERVICE_URL=http://localhost:4003
IDENTITY_ISSUER=anpardaz-platform
IDENTITY_PUBLIC_KEY_B64=generated-by-bootstrap-local

# Liquidity provider integration. Put real credentials in the runtime secret store,
# never in Git. Keep withdrawal permissions disabled until withdrawal flow is separately validated.
LIQUIDITY_PROVIDER_CODE=WALLEX
LIQUIDITY_PROVIDER_EXECUTION_ENABLED=false
WALLEX_API_BASE_URL=https://api.wallex.ir
WALLEX_API_KEY=local-secret-not-for-git
PROVIDER_HTTP_TIMEOUT_MS=10000
PROVIDER_MAX_SLIPPAGE_BPS=100
PROVIDER_RECONCILIATION_INTERVAL_MS=60000
PROVIDER_RECONCILIATION_TOLERANCE=0.00000001
ACCOUNTING_HTTP_TIMEOUT_MS=5000
WITHDRAWAL_DUAL_APPROVAL_THRESHOLD=0
