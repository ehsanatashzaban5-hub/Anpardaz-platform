version: "3.3"

services:
  anpardaz-db:
    image: postgres:17
    container_name: anpardaz-db
    restart: unless-stopped
    read_only: false
    security_opt: ["no-new-privileges:true"]
    cap_drop: ["ALL"]
    environment:
      POSTGRES_DB: anpardaz
      POSTGRES_USER: anpardaz
      POSTGRES_PASSWORD: ${ANPARDAZ_DB_PASSWORD}
    healthcheck: {test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"], interval: 5s, timeout: 5s, retries: 10}
    volumes: [anpardaz-db-data:/var/lib/postgresql/data]
    networks:
      - anpardaz-internal
